{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ts-node ./src/server.ts | pino-pretty",
    "start:prod": "node ./lib/server.js",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "clean": "rimraf lib",
    "docker:build": "docker build --tag server --file ./Dockerfile ../..",
    "docker:run": "docker run --rm --publish 3000:3000 server"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.2",
    "@azure/identity": "^4.14.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pino-http": "^11.0.0",
    "typechat": "0.1.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "verbose": true,
    "roots": [
      "<rootDir>/src"
    ]
  }
}
